{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=xtrasoft_db;Uid=username;Pwd=password;",
    "ApplicationDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=XtraSoft.Web;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "SmtpSettings": {
    "From": "email@example.com",
    "Host": "mail.example.com",
    "Port": 587,
    "Username": "username",
    "Password": "password"
  },
  "IpGeolocation": {
    "ApiKey": "your-IpGeolocation-key"
  },
  "DeepLConfig": {
    "AuthKey": "your-DeepLConfig-key",
    "SourceLang": "EN",
    "TargetLangEn": "EN-US",
    "TargetLangIt": "IT",
    "TargetLangFr": "FR",
    "TargetLangEs": "ES",
    "TargetLangDe": "DE",
    "TargetLangPt": "PT-PT"
  },
  "Administrator": {
    "Role": "Admin",
    "User": "email@example.com",
    "Password": "password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:9001" // ssl configured by reverse proxy, the app is a service
      }
    }
  },
  "AllowedHosts": "*"
}
